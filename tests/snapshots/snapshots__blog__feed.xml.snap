    <content type="html">&lt;ul class=&quot;toc&quot;&gt;&lt;li&gt;&lt;a href=&quot;#getting-started&quot;&gt;Getting started&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;a href=&quot;#getting-started-1&quot;&gt;Getting started&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;h2 id=&quot;getting-started&quot;&gt;Getting started&lt;/h2&gt;
&lt;p&gt;Some &lt;em&gt;markdown&lt;/em&gt; with a table:&lt;/p&gt;
&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;a&lt;/th&gt;&lt;th&gt;b&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h2 id=&quot;getting-started-1&quot;&gt;Getting started&lt;/h2&gt;
&lt;p&gt;Duplicate heading gets a unique id. Literal braces: {post.title} and {frontmatter.title} stay as written.&lt;/p&gt;
&lt;pre data-lang=&quot;html&quot; style=&quot;background-color:#2b303b;&quot;&gt;
&lt;span style=&quot;color:#c0c5ce;&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span style=&quot;color:#bf616a;&quot;&gt;include &lt;/span&gt;&lt;span style=&quot;color:#d08770;&quot;&gt;src&lt;/span&gt;&lt;span style=&quot;color:#c0c5ce;&quot;&gt;=&amp;quot;&lt;/span&gt;&lt;span style=&quot;color:#a3be8c;&quot;&gt;card.html&lt;/span&gt;&lt;span style=&quot;color:#c0c5ce;&quot;&gt;&amp;quot;&amp;gt;&amp;lt;/&lt;/span&gt;&lt;span style=&quot;color:#bf616a;&quot;&gt;include&lt;/span&gt;&lt;span style=&quot;color:#c0c5ce;&quot;&gt;&amp;gt;
&lt;/span&gt;&lt;/pre&gt;
</content>
